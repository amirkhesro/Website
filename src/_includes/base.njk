<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} | Amir Khesro</title>
    {# The Latin cut of Lora carries almost every page. Fetching it alongside
       the stylesheet rather than after it spares the reader a flash of
       fallback type. crossorigin is required even same origin for fonts. #}
    <link rel="preload" href="/fonts/lora-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    {# Home matches exactly; every other item also matches its child pages,
       so a post at /blog/<slug>/ marks Blog as the current page. #}
    {% set navItems = [
      { url: "/", label: "Home" },
      { url: "/whispers-through-the-fog/", label: "Whispers Through The Fog" },
      { url: "/acoustic-neuroma-handbook/", label: "The Acoustic Neuroma Handbook" },
      { url: "/signed-copies/", label: "Signed Copies" },
      { url: "/for-bookshops/", label: "For Bookshops" },
      { url: "/blog/", label: "Blog" },
      { url: "/about/", label: "About" },
      { url: "/connect/", label: "Connect" }
    ] %}
    <header>
      <nav>
        <ul>
          {% for item in navItems %}
          {% set isCurrent = (page.url == "/") if item.url == "/" else page.url.startsWith(item.url) %}
          <li><a href="{{ item.url }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer>
      <p>&copy; {{ currentYear }} Amir Khesro Publishing</p>
      <p class="footer-disclaimer">The content on this site reflects personal experience and research. It is not medical advice. Always consult your medical team about your own care.</p>
    </footer>
  </body>
</html>

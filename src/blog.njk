---
layout: base.njk
title: Blog
permalink: /blog/index.html
---
<h1>Blog</h1>

<ul>
  {% for post in collections.posts | reverse %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <time datetime="{{ post.date | htmlDate }}">{{ post.date | readableDate }}</time>
    </li>
  {% endfor %}
</ul>
